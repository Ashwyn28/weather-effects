{
  "name": "weather-effects",
  "version": "0.1.0",
  "description": "Transparent weather overlay for web pages: rain, snow, hail, wind, fog, clouds and droplet refraction.",
  "license": "MIT",
  "author": "Ashwyn Annauth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashwyn28/weather-effects.git"
  },
  "homepage": "https://github.com/Ashwyn28/weather-effects#readme",
  "keywords": [
    "weather",
    "rain",
    "snow",
    "webgl",
    "three",
    "particles",
    "effects"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "default": "./dist/advanced.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "python3 -m http.server 8000 --bind 127.0.0.1",
    "lint": "eslint . && prettier --check . && npm run docs:check",
    "docs:check": "node --import ./typedoc.ts6-shim.mjs node_modules/typedoc/bin/typedoc --emit none",
    "format": "prettier --write . && eslint --fix ."
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "three": "^0.186.1",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
