{
  "name": "weather-effects",
  "version": "0.1.0",
  "description": "Transparent weather overlay for web pages: rain, snow, hail, wind, fog, clouds and droplet refraction.",
  "license": "MIT",
  "author": "Ashwyn Annauth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashwyn28/weather-effects.git"
  },
  "homepage": "https://github.com/Ashwyn28/weather-effects#readme",
  "keywords": [
    "weather",
    "rain",
    "snow",
    "webgl",
    "three",
    "particles",
    "effects"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "default": "./dist/advanced.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "python3 -m http.server 8000 --bind 127.0.0.1",
    "lint": "eslint . && prettier --check . && npm run docs:check && npm run size && npm run check:package",
    "docs:check": "node --import ./typedoc.ts6-shim.mjs node_modules/typedoc/bin/typedoc --emit none",
    "format": "prettier --write . && eslint --fix .",
    "docs:api": "node --import ./typedoc.ts6-shim.mjs node_modules/typedoc/bin/typedoc --options typedoc.docs.json",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "size": "size-limit",
    "check:package": "publint && attw --pack . --profile esm-only",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "size-limit": "^14.3.0",
    "svelte": "^5.57.3",
    "three": "^0.186.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44"
  }
}
