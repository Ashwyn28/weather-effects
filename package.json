{
  "name": "weather-effects",
  "version": "0.1.0",
  "description": "Transparent weather overlay for web pages: rain, snow, hail, wind, fog, clouds and droplet refraction.",
  "license": "MIT",
  "author": "Ashwyn Annauth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashwyn28/weather-effects.git"
  },
  "homepage": "https://github.com/Ashwyn28/weather-effects#readme",
  "keywords": [
    "weather",
    "rain",
    "snow",
    "webgl",
    "three",
    "particles",
    "effects"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "python3 -m http.server 8000 --bind 127.0.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "private": true,
  "devDependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  }
}
